{
  "name": "alchimiste-de-brume",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "geometry": "esbuild --bundle --format=esm --platform=node --outfile=node_modules/.geometry.mjs src/ui/arena-geometry.ts --log-level=error && node scripts/geometry-check.mjs",
    "engine": "esbuild --bundle --format=esm --platform=node --outfile=node_modules/.engine-check.mjs scripts/engine-check.ts --log-level=error && node node_modules/.engine-check.mjs",
    "check": "npm run typecheck && npm run lint && npm run cycles && npm run engine && npm run geometry && npm test",
    "test": "jest --forceExit",
    "cycles": "node scripts/cycles.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-splash-screen": "~31.0.13",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.13.2",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~54.0.10",
    "esbuild": "^0.27.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "oxlint": "^1.71.0",
    "react-test-renderer": "^19.2.0",
    "typescript": "~5.9.2"
  },
  "main": "index.js",
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
