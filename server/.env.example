# URL de connexion PostgreSQL (utilisateur, mot de passe, hôte, port, base).
DATABASE_URL=postgresql://alchimiste:alchimiste@localhost:5432/alchimiste_auth

# Secret de signature des tokens JWT. Obligatoire, pas de valeur par défaut
# codée en dur : générer une valeur aléatoire longue avant tout déploiement réel
# (ex. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-any-real-deployment

# Port d'écoute HTTP du service.
PORT=3001
